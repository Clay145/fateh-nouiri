rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection (production lockdown):
    // - create: any visitor may submit an order (validated customer purchase).
    // - read/update/delete: CLOSED for web clients. Admin reads/writes go
    //   through the authed server API (Bearer HMAC token), which uses the
    //   Admin SDK and bypasses these rules.
    match /orders/{orderId} {
      allow read: if false;
      allow create: if request.resource.data.customerName is string &&
                       request.resource.data.phone is string;
      allow update, delete: if false;
    }
  }
}
