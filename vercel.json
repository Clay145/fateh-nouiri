{
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin-login"
    },
    {
      "source": "/api/admin/verify",
      "destination": "/api/admin-verify"
    },
    {
      "source": "/api/orders/stream",
      "destination": "/api/orders?id=stream"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/orders",
      "destination": "/api/orders"
    },
    {
      "source": "/api/create-order",
      "destination": "/api/orders"
    },
    {
      "source": "/api/create-order.php",
      "destination": "/api/orders"
    },
    {
      "source": "/api/purchase",
      "destination": "/api/orders"
    },
    {
      "source": "/api/verify-thank-you",
      "destination": "/api/verify-thank-you"
    },
    {
      "source": "/api/verify-thank-you.php",
      "destination": "/api/verify-thank-you"
    },
    {
      "source": "/api/mark-fb-sent",
      "destination": "/api/mark-fb-sent"
    },
    {
      "source": "/api/mark-fb-sent.php",
      "destination": "/api/mark-fb-sent"
    },
    {
      "source": "/api/meta/status",
      "destination": "/api/meta-status"
    },
    {
      "source": "/api/meta/test-event",
      "destination": "/api/meta-test-event"
    },
    {
      "source": "/api/analytics/:path*",
      "destination": "/api/analytics?path=:path*"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/analytics"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
