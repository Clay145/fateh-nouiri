{
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin-login"
    },
    {
      "source": "/api/admin/verify",
      "destination": "/api/admin-verify"
    },
    {
      "source": "/api/orders/stream",
      "destination": "/api/orders?id=stream"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/orders",
      "destination": "/api/orders"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
