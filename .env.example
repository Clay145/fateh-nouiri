# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_SECRET_KEY: Optional custom admin dashboard secret password. Defaults to theoria2026 if not set.
ADMIN_SECRET_KEY="theoria2026"

# Meta (Facebook) Pixel & Conversions API (CAPI) Configuration
# Primary Authorized Pixel ID for Theoria Store
META_PIXEL_ID="28477410788542282"

# Meta System User Conversions API Access Token (Generate in Events Manager > Settings > Conversions API > Generate access token)
META_CONVERSIONS_API_ACCESS_TOKEN=""

# Meta Events Manager Test Event Code (Optional, from Events Manager > Test Events tab, e.g. TEST12345)
META_TEST_EVENT_CODE=""
