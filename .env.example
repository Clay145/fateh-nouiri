# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_SECRET_KEY: REQUIRED for production. Admin dashboard password AND the
# HMAC signing secret for admin bearer tokens. Minimum 8 characters.
# There are NO default/fallback passwords — if unset, admin login is disabled
# (fail closed). Set a long random value, different from any previous password.
ADMIN_SECRET_KEY=""

# Meta (Facebook) Pixel & Conversions API (CAPI) Configuration
# Primary Authorized Pixel ID for Theoria Store
META_PIXEL_ID="28477410788542282"

# Meta System User Conversions API Access Token (Generate in Events Manager > Settings > Conversions API > Generate access token)
META_CONVERSIONS_API_ACCESS_TOKEN=""

# Meta Events Manager Test Event Code (Optional, from Events Manager > Test Events tab, e.g. TEST12345)
META_TEST_EVENT_CODE=""

# Server-side Firestore reader (REQUIRED on Vercel so admin reads/verify work
# after firestore.rules locks web-client reads). Canonical backend:
# project=theoria-store-24aa3, database=ai-studio-theoria-c8e9318c-768a-45a3-a424-f43b64f7ef3c.
# Paste ONE of:
# 1) FIREBASE_SERVICE_ACCOUNT_JSON: the full service-account JSON from
#    theoria-store-24aa3 (preferred; its project_id must be theoria-store-24aa3), or
# 2) FIREBASE_PROJECT_ID (=theoria-store-24aa3) + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
# Optional: FIRESTORE_DATABASE_ID (defaults to the canonical named database;
# never set it to "(default)" — orders do not live there).
FIREBASE_SERVICE_ACCOUNT_JSON=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# Browser Firebase web config (fixes "[Firebase] Client config projectId=..."
# console error). Values come from Firebase console > theoria-store-24aa3 >
# Project settings > Your apps > Web app > firebaseConfig. These override
# firebase-applet-config.json per field (Vite bakes them in at build time,
# so redeploy after changing). firestoreDatabaseId stays locked to the
# canonical named DB in src/lib/firebase.ts.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN="theoria-store-24aa3.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="theoria-store-24aa3"
# VITE_FIREBASE_STORAGE_BUCKET="theoria-store-24aa3.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_MEASUREMENT_ID=""

# CORS: extra allowed origins, comma-separated (the store domains + localhost
# are built in; add preview URLs here when needed).
ALLOWED_ORIGINS=""
